        "endMs": 11240
      },
      {
        "speaker": "Marsha",
        "english": "I am great!",
        "startMs": 11770,
        "endMs": 13240
      },
      {
        "speaker": "Anna",
        "english": "You know, Pete, I am new to D.C. The city is big.",
