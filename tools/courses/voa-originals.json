        "speaker": "Anna",
        "english": "Yes, I am excited!",
        "startMs": 24430,
        "endMs": 26370
      },
      {
        "speaker": "Caty",
        "english": "So sorry, but I am busy. Please meet your co-workers. But remember, they are busy working.",
        "startMs": 27160,
        "endMs": 36130
      },
      {
        "speaker": "Anna",
        "english": "Sure. Thanks, Ms. Weaver.",
        "startMs": 36770,
        "endMs": 38870
      },
      {
        "speaker": "Anna",
        "english": "Hi there! I’m Anna.",
        "startMs": 39230,
        "endMs": 41150
      },
      {
        "speaker": "Anne",
        "english": "Hi, Anna. I’m Anne.",
        "startMs": 41650,
        "endMs": 43160
      },
      {
        "speaker": "Anna",
        "english": "Nice to meet you. What are you doing?",
        "startMs": 43710,
        "endMs": 45755
      },
      {
        "speaker": "Anne",
        "english": "Um, I’m writing.",
        "startMs": 45755,
        "endMs": 47070
      },
      {
        "speaker": "Anna",
        "english": "You are writing! You are writing a lot!",
        "startMs": 47200,
        "endMs": 50670
      },
      {
        "speaker": "Anna",
        "english": "(Spills papers) Oh! Oh dear.",
        "startMs": 50670,
        "endMs": 52190
      },
      {
        "speaker": "Anne",
        "english": "No! No! That's okay.",
