      "durationMs": 120320
    },
    "segments": [
      {
        "speaker": "Anna",
        "english": "I am in my new apartment! Great!",
        "startMs": 1550,
        "endMs": 11670
      },
      {
        "speaker": "Anna",
        "english": "I live with Marsha. We’re roommates.",
        "startMs": 12200,
        "endMs": 15410
      },
      {
        "speaker": "Anna",
        "english": "I want to cook dinner. Oh! Hmmm. Is there a supermarket near here?",
        "startMs": 16670,
        "endMs": 29260
      },
      {
        "speaker": "Anna",
        "english": "Marsha knows. Marsha's work number is 555-8986.",
        "startMs": 30370,
        "endMs": 41290
      },
      {
        "speaker": "Man",
        "english": "Hello.",
        "startMs": 42770,
        "endMs": 43620
      },
      {
        "speaker": "Anna",
        "english": "Hello. Is this Marsha? It is Anna.",
        "startMs": 43620,
        "endMs": 46400
      },
      {
        "speaker": "Man",
        "english": "I am sorry. You have the wrong number.",
        "startMs": 46400,
        "endMs": 49250
      },
      {
        "speaker": "Anna",
        "english": "Oh. Is this 555-8986?",
        "startMs": 49250,
        "endMs": 53900
      },
      {
        "speaker": "Man",
        "english": "No. This is 555-8689.",
        "startMs": 54560,
        "endMs": 58960
      },
      {
        "speaker": "Anna",
        "english": "Oh. Excuse me!",
        "startMs": 60020,
        "endMs": 61630
      },
      {
        "speaker": "Man",
        "english": "Okay. 'Bye.",
        "startMs": 61630,
        "endMs": 62920
      },
      {
        "speaker": "Anna",
        "english": "One more time. 555-8986. Please be Marsha.",
        "startMs": 64160,
        "endMs": 72470
      },
      {
        "speaker": "Marsha",
        "english": "Hello. This is Marsha.",
        "startMs": 75620,
        "endMs": 77660
      },
      {
        "speaker": "Anna",
        "english": "Yes, Marsha. I want to cook dinner.",
        "startMs": 77660,
        "endMs": 80550
      },
      {
        "speaker": "Marsha",
        "english": "Excuse me? Anna? Is that you?",
        "startMs": 80550,
        "endMs": 83610
      },
      {
        "speaker": "Anna",
        "english": "Oh, yes. I am here!",
        "startMs": 83610,
        "endMs": 85160
      },
      {
        "speaker": "Marsha",
        "english": "Good. You are there.",
        "startMs": 85310,
        "endMs": 87280
      },
      {
        "speaker": "Anna",
        "english": "I want to find a supermarket.",
        "startMs": 87440,
        "endMs": 90370
      },
      {
        "speaker": "Marsha",
        "english": "Oh, okay. The supermarket is at 1500 Irving Street. It is near the apartment.",
        "startMs": 90370,
        "endMs": 98590
      },
      {
        "speaker": "Anna",
        "english": "Great! Goodbye!",
        "startMs": 98590,
        "endMs": 100710
      },
      {
        "speaker": "Marsha",
        "english": "Goodbye, Anna.",
        "startMs": 100710,
        "endMs": 101730
      },
      {
        "speaker": "Anna",
        "english": "There is a big supermarket on our street. And Marsha says I am a good cook! Until next time! Bye!",
        "startMs": 102850,
        "endMs": 115030
      }
    ]
  },
