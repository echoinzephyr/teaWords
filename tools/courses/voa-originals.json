      "durationMs": 60656
    },
    "segments": [
      {
        "speaker": "Anna",
        "english": "Hello, everyone! Today my friend Marsha is at her friend's house. She says it is beautiful. I want to see this house! Here we are!",
        "startMs": 1770,
        "endMs": 14940
      },
      {
        "speaker": "Anna",
        "english": "Marsha, I am in the kitchen! It is a beautiful kitchen!",
        "startMs": 15670,
        "endMs": 21370
      },
      {
        "speaker": "Marsha",
        "english": "It is beautiful. We cook in the kitchen.",
        "startMs": 22080,
        "endMs": 27120
      },
      {
        "speaker": "Anna",
        "english": "I eat in the kitchen.",
        "startMs": 27560,
        "endMs": 29920
      },
      {
        "speaker": "Marsha",
        "english": "We relax in the living room.",
        "startMs": 30680,
        "endMs": 33700
      },
      {
        "speaker": "Anna",
        "english": "I relax in the living room. Marsha, let’s go upstairs!",
        "startMs": 35000,
        "endMs": 40520
      },
      {
        "speaker": "Marsha",
        "english": "Anna? Where are you?",
        "startMs": 41670,
        "endMs": 44430
      },
      {
        "speaker": "Anna",
        "english": "Marsha, I am in the bathroom! I wash in the bathroom.",
        "startMs": 45820,
        "endMs": 50660
      },
      {
        "speaker": "Marsha",
        "english": "I am in the bedroom. We sleep in the bedroom.",
        "startMs": 51590,
        "endMs": 56160
      },
      {
        "speaker": "Anna",
        "english": "I sleep in the bedroom!",
        "startMs": 56670,
        "endMs": 58940
      }
    ]
  },
  {
    "number": 6,
    "url": "https://learningenglish.voanews.com/a/lets-learn-english-lesson-6-where-is-the-gym/3225958.html",
    "audio": {
      "url": "https://voa-audio.voanews.eu/vle/2016/03/10/66b63229-1dc5-40ab-886d-1f4b891adf6b.mp3",
      "sha256": "a2ea933905fe40a710160ac8d8b128631b8736c9b61dbd96cbc348c7d5a09cf5",
      "bytes": 864592,
      "durationMs": 108042
    },
    "segments": [
      {
        "speaker": "Anna",
        "english": "Hi there! I’m Anna and I live in Washington, D.C. Every day I learn more about this great city. People in Washington like to work out! Oh, hi, Pete. How’s it going?",
        "startMs": 2000,
        "endMs": 16830
      },
      {
        "speaker": "Pete",
        "english": "Hi, Anna. It’s going great. How’s it going with you?",
        "startMs": 17550,
        "endMs": 22780
      },
      {
        "speaker": "Anna",
        "english": "Things are awesome! Pete, I want to work out. Where is the gym?",
        "startMs": 23180,
        "endMs": 29560
      },
      {
        "speaker": "Pete",
        "english": "The gym is across from the lounge. It’s next to the mailroom. Go that way.",
        "startMs": 30310,
        "endMs": 37670
      },
      {
        "speaker": "Anna",
        "english": "Thanks, Pete!",
        "startMs": 38520,
        "endMs": 39590
      },
      {
        "speaker": "Pete",
        "english": "No, Anna! Not that way! Go that way!",
        "startMs": 40090,
        "endMs": 44550
      },
      {
        "speaker": "Anna",
        "english": "Oh, Pete. This is not the gym.",
        "startMs": 45500,
        "endMs": 49220
      },
      {
        "speaker": "Pete",
        "english": "That’s right, Anna. This is the mailroom.",
        "startMs": 50140,
        "endMs": 53440
      },
      {
        "speaker": "Anna",
        "english": "The gym is across from … what?",
        "startMs": 54330,
        "endMs": 57520
      },
      {
        "speaker": "Pete",
        "english": "The gym is across from the lounge.",
        "startMs": 57890,
        "endMs": 61390
      },
      {
        "speaker": "Anna",
        "english": "Across from the lounge. Right. Thanks!",
        "startMs": 61850,
        "endMs": 65410
      },
      {
        "speaker": "Anna",
        "english": "Pete! This is not the gym!",
        "startMs": 66760,
        "endMs": 69650
      },
      {
        "speaker": "Pete",
        "english": "The gym is across from the lounge. It is behind the lobby.",
        "startMs": 70730,
        "endMs": 76120
      },
      {
        "speaker": "Anna",
        "english": "Right. Right. See you.",
        "startMs": 76180,
        "endMs": 78310
      },
      {
        "speaker": "Pete",
        "english": "See you, Anna!",
        "startMs": 78760,
        "endMs": 79840
      },
      {
        "speaker": "Anna",
        "english": "See you.",
        "startMs": 80560,
        "endMs": 81480
      },
      {
        "speaker": "Pete",
        "english": "See you, Anna.",
        "startMs": 82130,
        "endMs": 83390
      },
      {
        "speaker": "Anna",
        "english": "This is not the gym. This is a parking garage.",
        "startMs": 84570,
        "endMs": 89500
      },
      {
        "speaker": "Anna",
        "english": "Hello? Pete?",
        "startMs": 90420,
        "endMs": 92470
      },
      {
        "speaker": "Anna",
        "english": "This is not a gym. This is a rooftop.",
        "startMs": 94360,
        "endMs": 99000
      },
      {
        "speaker": "Anna",
        "english": "Pete! Pete?",
        "startMs": 100050,
        "endMs": 101740
      },
      {
        "speaker": "Pete",
        "english": "I want to work out too! Join me!",
        "startMs": 102450,
        "endMs": 105820
      },
      {
        "speaker": "Anna",
        "english": "I’m good.",
        "startMs": 106290,
        "endMs": 107170
      }
    ]
  },
  {
    "number": 7,
    "url": "https://learningenglish.voanews.com/a/lets-learn-english-lesson-7-what-are-you-doing/3240468.html",
