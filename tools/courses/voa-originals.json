  {
    "number": 8,
    "url": "https://learningenglish.voanews.com/a/lets-learn-english-lesson-8-are-you-busy/3253185.html",
    "audio": {
      "url": "https://voa-audio.voanews.eu/vle/2016/03/25/ae6c5055-13ae-485b-995d-b347125ecf10.mp3",
      "sha256": "3f395c7bf4eab262446e33bfea84de551775aa869c22d5cf541167e45ca63aed",
      "bytes": 948911,
      "durationMs": 118570
    },
    "segments": [
      {
        "speaker": "Anna",
        "english": "Hello, everyone. Here I am at my new job! Yesterday at my first day of work … Well, let’s not talk about yesterday. Today is a new day! Today I want to apologize to my co-workers.",
        "startMs": 2300,
        "endMs": 16780
      },
      {
        "speaker": "Anna",
        "english": "Hi, Anne. Are you busy?",
        "startMs": 18780,
        "endMs": 20890
      },
      {
        "speaker": "Anne",
        "english": "Hi, Anna. Yes. At 10 a.m. I am writing. Every day I do my morning show. Sorry!",
        "startMs": 20960,
        "endMs": 30240
      },
      {
        "speaker": "Anna",
        "english": "Okay. See you later, maybe.",
        "startMs": 30890,
        "endMs": 34780
      },
      {
        "speaker": "Anne",
        "english": "Maybe I’ll see you later.",
        "startMs": 35820,
        "endMs": 37250
      },
      {
        "speaker": "Anna",
        "english": "Hi, Jonathan. Are you busy?",
        "startMs": 38290,
        "endMs": 40810
      },
      {
        "speaker": "Jonathan",
        "english": "Yes, I’m busy. When the studio light is on, I am recording my evening show.",
        "startMs": 40810,
        "endMs": 46780
      },
      {
        "speaker": "Anna",
        "english": "Right. Sorry about yesterday.",
        "startMs": 46780,
        "endMs": 49360
      },
      {
        "speaker": "Jonathan",
        "english": "No worries.",
        "startMs": 49440,
        "endMs": 50460
      },
      {
        "speaker": "Anna",
        "english": "May I see the studio?",
        "startMs": 50550,
        "endMs": 51930
      },
      {
        "speaker": "Jonathan",
        "english": "Um, maybe another time? Right now I am busy.",
        "startMs": 51930,
        "endMs": 55270
      },
      {
        "speaker": "Anna",
        "english": "Sure. Okay, ’bye.",
        "startMs": 55990,
        "endMs": 58690
      },
      {
        "speaker": "Jonathan",
        "english": "‘Bye.",
        "startMs": 58880,
        "endMs": 59410
      },
      {
        "speaker": "Anna",
        "english": "Hi, Amelia! Are you busy?",
        "startMs": 59430,
        "endMs": 62040
      },
      {
        "speaker": "Amelia",
        "english": "I’m a little busy.",
        "startMs": 62110,
        "endMs": 63510
      },
      {
        "speaker": "Anna",
        "english": "I want to say I’m sorry for yesterday.",
        "startMs": 63510,
        "endMs": 67670
      },
      {
        "speaker": "Amelia",
        "english": "It’s okay, Anna.",
        "startMs": 67860,
        "endMs": 69030
      },
      {
        "speaker": "Anna",
        "english": "Well, I am sorry.",
        "startMs": 69320,
        "endMs": 70780
      },
      {
        "speaker": "Amelia",
        "english": "It’s okay, Anna. Come by this afternoon.",
        "startMs": 70970,
        "endMs": 73530
      },
      {
        "speaker": "Anna",
        "english": "Okay.",
        "startMs": 74100,
        "endMs": 74760
      },
      {
        "speaker": "Caty",
        "english": "Anna.",
        "startMs": 75840,
        "endMs": 76350
      },
      {
        "speaker": "Anna",
        "english": "Yes, Ms. Weaver.",
        "startMs": 77260,
        "endMs": 78620
      },
      {
        "speaker": "Caty",
        "english": "Are you busy?",
        "startMs": 78620,
        "endMs": 79610
      },
      {
        "speaker": "Anna",
        "english": "Yes, Ms. Weaver. I am busy.",
        "startMs": 79610,
        "endMs": 81530
      },
      {
        "speaker": "Caty",
        "english": "My office. 5:00 p.m.",
        "startMs": 81970,
        "endMs": 83890
      },
      {
        "speaker": "Anna",
        "english": "5:00 p.m.",
        "startMs": 86280,
        "endMs": 87100
      },
      {
        "speaker": "Caty",
        "english": "Come in.",
        "startMs": 89000,
        "endMs": 97410
      },
      {
        "speaker": "Co-Workers",
        "english": "Surprise!",
        "startMs": 99150,
        "endMs": 99750
      },
      {
        "speaker": "Anna",
        "english": "A party! Awesome! And I still have my job! Phew! Until next time!",
        "startMs": 102180,
        "endMs": 117210
      }
    ]
