        "english": "Hey, Pete! Who’s your friend?",
        "startMs": 1400,
        "endMs": 3500
      },
      {
        "speaker": "Pete",
        "english": "She is Anna. She is new to D.C.",
        "startMs": 4100,
        "endMs": 6310
      },
      {
        "speaker": "Jonathan",
        "english": "Where are you from?",
        "startMs": 6990,
        "endMs": 7870
      },
      {
        "speaker": "Anna",
        "english": "I am from a small town.",
        "startMs": 8040,
        "endMs": 9990
      },
      {
        "speaker": "Jonathan",
        "english": "Well, welcome to D.C.",
        "startMs": 10640,
        "endMs": 12270
      },
      {
        "speaker": "Anna",
        "english": "Thank you.",
        "startMs": 12270,
        "endMs": 13200
      },
      {
        "speaker": "Jonathan",
        "english": "I am Jonathan. I am in apartment B4.",
        "startMs": 13200,
        "endMs": 16170
      },
      {
        "speaker": "Anna",
        "english": "I am in apartment C2. Marsha is my roommate.",
        "startMs": 16660,
        "endMs": 21000
      },
      {
        "speaker": "Jonathan",
        "english": "I know Marsha. She is nice.",
        "startMs": 21650,
        "endMs": 24240
      },
      {
        "speaker": "Pete",
        "english": "And I am in Apartment D7. I have to go now.",
        "startMs": 24970,
        "endMs": 29910
      },
      {
        "speaker": "Anna",
        "english": "Oh!",
        "startMs": 30490,
        "endMs": 30940
      },
      {
        "speaker": "Pete",
        "english": "Remember to call Marsha at work. Tell her you’re here.",
        "startMs": 31760,
        "endMs": 34990
      },
      {
        "speaker": "Anna",
        "english": "Right, thanks, Pete. Nice to meet you!",
        "startMs": 34990,
        "endMs": 38020
      },
