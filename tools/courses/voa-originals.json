      },
      {
        "speaker": "Anna",
        "english": "Oh! Hi!",
        "startMs": 98080,
        "endMs": 98550
      },
      {
        "speaker": "Amelia",
        "english": "- is an adjective.",
        "startMs": 98550,
        "endMs": 99650
      },
      {
        "speaker": "Anna",
        "english": "Hi! I’m Anna!",
        "startMs": 99650,
        "endMs": 101410
      },
      {
        "speaker": "Amelia",
        "english": "Hi. I’m Amelia.",
        "startMs": 101610,
        "endMs": 103040
      },
      {
        "speaker": "Anna",
        "english": "Nice to meet you!",
        "startMs": 103040,
        "endMs": 104010
      },
      {
        "speaker": "Anna",
        "english": "What are you doing?",
        "startMs": 104830,
        "endMs": 106050
      },
      {
        "speaker": "Amelia",
        "english": "I’m reading.",
        "startMs": 106530,
        "endMs": 108110
      },
      {
        "speaker": "Anna",
        "english": "Are you reading the news? Hi!",
