        "endMs": 58520
      },
      {
        "speaker": "Anna",
        "english": "I have a ....",
        "startMs": 59340,
        "endMs": 61170
      },
      {
        "speaker": "Pete",
        "english": "And it is a pillow!",
        "startMs": 61930,
        "endMs": 64330
      },
      {
        "speaker": "Anna",
        "english": "Pete, Marsha, I know I have a pen.",
        "startMs": 64910,
        "endMs": 68720
      },
      {
        "speaker": "Marsha",
        "english": "Anna, it is a map.",
        "startMs": 70210,
        "endMs": 71900
      },
      {
        "speaker": "Pete",
        "english": "Why do you have a map of the world?",
        "startMs": 72950,
        "endMs": 75470
      },
      {
        "speaker": "Anna",
        "english": "Pete, Marsha. Now I know I have a pen.",
        "startMs": 76000,
        "endMs": 79760
      },
      {
        "speaker": "Pete",
        "english": "And now you have a lamp.",
        "startMs": 80760,
        "endMs": 82910
      },
      {
        "speaker": "Marsha",
        "english": "Anna.",
        "startMs": 83780,
        "endMs": 84440
      },
      {
        "speaker": "Anna",
        "english": "I have a pen! Let’s get coffee!",
        "startMs": 85170,
        "endMs": 88350
      }
    ]
  },
  {
    "number": 5,
    "url": "https://learningenglish.voanews.com/a/lets-learn-english-lesson-5-where-are-you/3168971.html",
    "audio": {
      "url": "https://voa-audio.voanews.eu/vle/2016/03/01/ab9c2944-eddc-4806-9296-290bfa8c6ff2.mp3",
