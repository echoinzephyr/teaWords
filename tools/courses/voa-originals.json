        "endMs": 24980
      },
      {
        "speaker": "Anna",
        "english": "The new apartment is great! Let's get coffee!",
        "startMs": 25730,
        "endMs": 30110
      },
      {
        "speaker": "Marsha",
        "english": "Anna, do you have a pen?",
        "startMs": 30920,
        "endMs": 32840
      },
      {
        "speaker": "Anna",
        "english": "Yes. I have a pen in my bag.",
        "startMs": 33850,
        "endMs": 36360
      },
      {
        "speaker": "Anna",
        "english": "I have a …",
        "startMs": 36860,
        "endMs": 38210
      },
      {
        "speaker": "Pete",
        "english": "It is not a pen. It is a book. It is a big book.",
        "startMs": 38210,
        "endMs": 44990
      },
      {
        "speaker": "Anna",
        "english": "Yes. Yes it is, Pete. I know I have a pen, though…",
