      "durationMs": 189440
    },
    "segments": [
      {
        "speaker": "Anna",
        "english": "Hello! Washington, D.C. has many beautiful parks. In fact, this park reminds me of my home very far away.",
        "startMs": 640,
        "endMs": 12950
      },
      {
        "speaker": "Marsha",
        "english": "Anna, here's your coffee.",
        "startMs": 14180,
        "endMs": 16470
      },
      {
        "speaker": "Anna",
        "english": "Thanks, Marsha.",
        "startMs": 17090,
        "endMs": 18070
      },
      {
        "speaker": "Marsha",
        "english": "What's wrong?",
        "startMs": 18290,
        "endMs": 19360
      },
      {
        "speaker": "Anna",
        "english": "I'm thinking about my family. I'm feeling homesick.",
        "startMs": 20020,
        "endMs": 25380
      },
      {
        "speaker": "Marsha",
        "english": "Do you want to talk about it?",
        "startMs": 25660,
        "endMs": 27100
      },
      {
        "speaker": "Anna",
        "english": "Sure! I have some photos.",
        "startMs": 27800,
        "endMs": 30760
      },
      {
        "speaker": "Marsha",
        "english": "Yes. Yes, you do!",
        "startMs": 31650,
        "endMs": 33970
      },
      {
        "speaker": "Anna",
        "english": "Photos really help.",
        "startMs": 34380,
        "endMs": 36080
      },
      {
        "speaker": "Anna",
        "english": "This is my mother and this is my father. They are rodeo clowns.",
        "startMs": 37330,
        "endMs": 43260
      },
      {
        "speaker": "Marsha",
        "english": "What do rodeo clowns do?",
        "startMs": 43970,
        "endMs": 47210
      },
      {
        "speaker": "Anna",
        "english": "They make jokes at a rodeo. They make people laugh.",
        "startMs": 47740,
        "endMs": 51230
      },
      {
        "speaker": "Marsha",
        "english": "That—that's very different.",
        "startMs": 51230,
        "endMs": 54490
      },
      {
        "speaker": "Marsha",
        "english": "Who is that woman in the picture?",
        "startMs": 54490,
        "endMs": 56090
      },
      {
        "speaker": "Anna",
        "english": "That is my Aunt Lavender. She is my mom's sister. She loves gardening and makes spoons.",
        "startMs": 56090,
        "endMs": 64760
      },
      {
        "speaker": "Marsha",
        "english": "She makes spoons?",
        "startMs": 65440,
        "endMs": 67200
      },
      {
        "speaker": "Anna",
        "english": "Of course.",
        "startMs": 67630,
        "endMs": 68580
      },
      {
        "speaker": "Marsha",
        "english": "That, too, is very different.",
        "startMs": 69310,
        "endMs": 72780
      },
      {
        "speaker": "Anna",
        "english": "Oh! This is my Uncle John. He is my father's brother.",
        "startMs": 73590,
        "endMs": 77870
      },
      {
        "speaker": "Marsha",
        "english": "What does Uncle John do?",
        "startMs": 78890,
        "endMs": 81670
      },
      {
        "speaker": "Anna",
        "english": "He's a chicken farmer. And makes guitars. He's awesome, and I'm his favorite niece.",
        "startMs": 81670,
        "endMs": 89320
      },
      {
        "speaker": "Marsha",
        "english": "Who are they?",
        "startMs": 89800,
        "endMs": 90640
      },
      {
        "speaker": "Anna",
        "english": "They are my cousins. They are my Uncle John's daughter and son.",
        "startMs": 90640,
        "endMs": 96290
      },
      {
        "speaker": "Marsha",
        "english": "What do they do?",
        "startMs": 96690,
        "endMs": 97930
      },
      {
        "speaker": "Anna",
        "english": "They raise sheep and make sweaters.",
        "startMs": 98260,
        "endMs": 101110
      },
      {
        "speaker": "Marsha",
        "english": "Yeah, that's not a surprise.",
        "startMs": 101330,
        "endMs": 103930
      },
      {
        "speaker": "Marsha",
        "english": "Thanks for showing me your family photos. Your family is very different.",
        "startMs": 104750,
        "endMs": 111190
      },
      {
        "speaker": "Anna",
        "english": "I do feel better. Thanks for listening. I have many more photos!",
        "startMs": 111190,
        "endMs": 116340
      },
      {
        "speaker": "Marsha",
        "english": "Yeah. Yeah, you do.",
        "startMs": 116760,
        "endMs": 119100
      },
      {
        "speaker": "Anna",
        "english": "Washington, DC is my new home. But I like remembering my old home, too.",
        "startMs": 119820,
        "endMs": 125260
      },
      {
        "speaker": "Narrator",
        "english": "This is a family tree. Anna tells Marsha about her parents.",
        "startMs": 127110,
        "endMs": 132890
      },
      {
        "speaker": "Narrator",
        "english": "Her mother and father are rodeo clowns.",
        "startMs": 133870,
        "endMs": 137390
      },
      {
        "speaker": "Narrator",
        "english": "Her father's parents are from Italy. These grandparents speak Italian.",
        "startMs": 138380,
        "endMs": 144910
      },
      {
        "speaker": "Narrator",
        "english": "Anna's mother's parents live in California. These grandparents have a farm and raise horses.",
        "startMs": 146250,
        "endMs": 154840
      },
      {
        "speaker": "Narrator",
        "english": "Anna's mother's sister is Aunt Lavender. She loves gardening.",
        "startMs": 156530,
        "endMs": 162270
      },
      {
        "speaker": "Narrator",
        "english": "Anna's father has a brother. His name is John. Uncle John makes guitars.",
        "startMs": 163440,
        "endMs": 170730
      },
      {
        "speaker": "Narrator",
        "english": "Uncle John has a daughter and a son. They are Anna's cousins. They raise sheep.",
        "startMs": 171620,
        "endMs": 178820
      },
      {
        "speaker": "Narrator",
        "english": "Anna's brother has two children. They are Anna's niece and nephew.",
        "startMs": 179850,
        "endMs": 185790
      }
    ]
  }
]
